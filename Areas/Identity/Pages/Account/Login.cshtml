            285.201299-7.965081 132.001952-111.177119 262.654979 0
            c122.944884 104.650891 243.859957-1.78572 243.859958-1.78572z"
                  fill="#178E3B" />
        </svg>

        <!-- Logo: delfín SVG completo en miniatura dentro de cuadro blanco -->
        <div class="panel-logo-wrap">
            <div class="logo-box">
