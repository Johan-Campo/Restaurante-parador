            </div>
            <div>
                <div class="logo-brand">Estadero Parador<br>Turístico</div>
                <div class="logo-tagline">Gestión de sucursales y productos</div>
            </div>
        </div>

        <!-- Contenido interior exclusivo del Login -->
        <div class="panel-body">
            <h2>Bienvenido de nuevo</h2>
            <p class="panel-desc">
                Accede a tu panel para gestionar sucursales,
                categorías y el catálogo de productos de tu restaurante.
            </p>

            <div class="feat-chip">
                <div class="feat-icon"><i class="fas fa-store"></i></div>
                Gestión de sucursales
            </div>
            <div class="feat-chip">
                <div class="feat-icon"><i class="fas fa-tags"></i></div>
                Control de categorías
            </div>
            <div class="feat-chip">
                <div class="feat-icon"><i class="fas fa-utensils"></i></div>
                Catálogo de productos
            </div>
        </div>

        <div class="panel-footer">© 2026 Estadero Parador Turístico · Todos los derechos reservados</div>
    </div>

    <!-- ══════════════════════════════════════
         FORMULARIO
    ══════════════════════════════════════ -->
    <div class="auth-form-side">
        <div class="auth-box">

            <div class="auth-badge">
                <span class="dot"></span>
                Panel administrativo
            </div>

            <div class="auth-box-header">
                <h3>Iniciar sesión</h3>
                <p>Ingresa tus credenciales para continuar</p>
            </div>

            <form method="post" id="loginForm">
                <div asp-validation-summary="ModelOnly" class="text-danger"
                     style="margin-bottom:14px;font-size:.82rem;"></div>

                <div class="field-group">
                    <label asp-for="Input.Email" class="field-label"></label>
                    <div class="field-wrap">
                        <i class="fas fa-envelope field-icon"></i>
                        <input asp-for="Input.Email" class="field-input"
                               placeholder="correo@ejemplo.com" autocomplete="email" />
                    </div>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="field-group">
                    <label asp-for="Input.Password" class="field-label"></label>
                    <div class="field-wrap">
                        <i class="fas fa-lock field-icon"></i>
                        <input asp-for="Input.Password" class="field-input"
                               placeholder="••••••••" autocomplete="current-password" />
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="remember-row">
                    <input asp-for="Input.RememberMe" />
                    <label asp-for="Input.RememberMe">Mantener sesión iniciada</label>
                </div>

                <button type="submit" class="btn-submit">
                    <i class="fas fa-arrow-right-to-bracket"></i>
                    Entrar al panel
                </button>

                <div class="auth-divider"><span>¿No tienes cuenta?</span></div>
                <div class="auth-link-row">
                    <a asp-page="./Register">Regístrate aquí</a>
                </div>
            </form>
        </div>
    </div>

</div><!-- /.auth-shell -->
@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function() {

            // errores del validation summary
            var errItems = document.querySelectorAll('.validation-summary-errors li');

            if (errItems.length > 0) {
                showToast(
                    'error',
                    'Error al iniciar sesión',
                    errItems[0].textContent.trim()
                );
            }

            // Toast éxito login
            @if (TempData["ToastSuccess"] != null)
                {
                    <text>
                        showToast(
                            'success',
                            '¡Bienvenido!',
                            @Html.Raw(JsonSerializer.Serialize(TempData["ToastSuccess"]))
                        );
                </text>
            }

                // Toast error login
                @if (TempData["ToastError"] != null)
                {
                    <text>
                        showToast(
                            'error',
                            'Acceso denegado',
                            @Html.Raw(JsonSerializer.Serialize(TempData["ToastError"]))
                        );
                </text>
            }

                // Toast warning login
                @if (TempData["ToastWarning"] != null)
                {
                    <text>
                        showToast(
                            'warning',
                            'Advertencia',
                            @Html.Raw(JsonSerializer.Serialize(TempData["ToastWarning"]))
                        );
                </text>
            }

                });

        // Validación cliente antes de enviar
        document.getElementById('loginForm').addEventListener('submit', function(e) {

            var email = document.querySelector('[name="Input.Email"]').value.trim();
            var pass = document.querySelector('[name="Input.Password"]').value.trim();

            if (!email || !pass) {
                e.preventDefault();

                showToast(
                    'warning',
                    'Campos requeridos',
                    'Por favor completa el correo y la contraseña antes de continuar.'
                );
            }

        });

    </script>

}