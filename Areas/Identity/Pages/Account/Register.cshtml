            </div>
            <div>
                <div class="logo-brand">Estadero Parador<br>Turístico</div>
                <div class="logo-tagline">Gestión de sucursales y productos</div>
            </div>
        </div>

        <!-- Contenido interior exclusivo del Register -->
        <div class="panel-body">
            <h2>Crea tu cuenta</h2>
            <p class="panel-desc">
                En tres pasos sencillos tendrás acceso completo
                al panel de administración de tu restaurante.
            </p>

            <div class="step-item">
                <div class="step-num">1</div>
                <div class="step-text">
                    <div class="step-title">Ingresa tu correo</div>
                    Usa un correo válido al que tengas acceso
                </div>
            </div>
            <div class="step-item">
                <div class="step-num">2</div>
                <div class="step-text">
                    <div class="step-title">Crea una contraseña</div>
                    Mínimo 6 caracteres con letra y número
                </div>
            </div>
            <div class="step-item">
                <div class="step-num">3</div>
                <div class="step-text">
                    <div class="step-title">Accede al panel</div>
                    Gestiona sucursales, categorías y productos
                </div>
            </div>
        </div>

        <div class="panel-footer">© 2026 Estadero Parador Turístico · Todos los derechos reservados</div>
    </div>

    <!-- ══════════════════════════════════════
         FORMULARIO
    ══════════════════════════════════════ -->
    <div class="auth-form-side">
        <div class="auth-box">

            <div class="auth-badge">
                <span class="dot"></span>
                Nuevo registro
            </div>

            <div class="auth-box-header">
                <h3>Crear cuenta</h3>
                <p>Completa los campos para registrarte</p>
            </div>

            <form method="post" id="registerForm">
                <div asp-validation-summary="ModelOnly" class="text-danger"
                     style="margin-bottom:12px;font-size:.82rem;"></div>

                <div class="field-group">
                    <label asp-for="Input.Email" class="field-label"></label>
                    <div class="field-wrap">
                        <i class="fas fa-envelope field-icon"></i>
                        <input asp-for="Input.Email" class="field-input"
                               placeholder="correo@ejemplo.com" autocomplete="email" />
                    </div>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="field-group">
                    <label asp-for="Input.Password" class="field-label"></label>
                    <div class="field-wrap">
                        <i class="fas fa-lock field-icon"></i>
                        <input asp-for="Input.Password" class="field-input" id="pwInput"
                               placeholder="••••••••" autocomplete="new-password" />
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                    <!-- Barra de seguridad -->
                    <div class="strength-wrap">
                        <div class="strength-bars">
                            <div class="strength-seg" id="s1"></div>
                            <div class="strength-seg" id="s2"></div>
                            <div class="strength-seg" id="s3"></div>
                            <div class="strength-seg" id="s4"></div>
                        </div>
                        <div class="strength-lbl" id="sLabel"></div>
                    </div>
                    <div class="field-hint">
                        <i class="fas fa-circle-info"></i>
                        Mínimo 6 caracteres, letras y números.
                    </div>
                </div>

                <div class="field-group">
                    <label asp-for="Input.ConfirmPassword" class="field-label"></label>
                    <div class="field-wrap">
                        <i class="fas fa-lock field-icon"></i>
                        <input asp-for="Input.ConfirmPassword" class="field-input" id="cfInput"
                               placeholder="••••••••" autocomplete="new-password" />
                    </div>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="btn-submit">
                    <i class="fas fa-user-plus"></i>
                    Crear cuenta
                </button>

                <div class="auth-divider"><span>¿Ya tienes cuenta?</span></div>
                <div class="auth-link-row">
                    <a asp-page="./Login">Inicia sesión aquí</a>
                </div>
            </form>
        </div>
    </div>

</div><!-- /.auth-shell -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // ── Barra de seguridad de contraseña ──
        var pwColors = ['#e11d48', '#d97706', '#16a34a', '#0891b2'];
        var pwLabels = ['Muy débil', 'Débil', 'Buena', 'Muy fuerte'];

        document.getElementById('pwInput').addEventListener('input', function() {
            var v = this.value;
            var score = 0;
            if (v.length >= 6) score++;
            if (v.length >= 10) score++;
            if (/[A-Z]/.test(v) && /[0-9]/.test(v)) score++;
            if (/[^A-Za-z0-9]/.test(v)) score++;

            for (var i = 1; i <= 4; i++) {
                document.getElementById('s' + i).style.background =
                    i <= score ? pwColors[score - 1] : '#e5e7eb';
            }
            var lbl = document.getElementById('sLabel');
            lbl.textContent = v.length > 0 ? pwLabels[Math.max(0, score - 1)] : '';
            lbl.style.color = v.length > 0 ? pwColors[Math.max(0, score - 1)] : '';
        });

        // ── Toasts del servidor ──
        document.addEventListener('DOMContentLoaded', function() {

            var errItems = document.querySelectorAll('.validation-summary-errors li');
            if (errItems.length > 0) {
                showToast('error', 'No se pudo crear la cuenta',
                    errItems[0].textContent.trim() || 'Revisa los datos e inténtalo de nuevo.');
            }

            @if (TempData["RegisterSuccess"] != null)
                {
                    <text>
                        showToast('success', '¡Cuenta creada!',
                                @Html.Raw(JsonSerializer.Serialize(TempData["RegisterSuccess"]?.ToString())));
                </text>
            }

                @if (TempData["RegisterError"] != null)
                {
                    <text>
                        showToast('error', 'Error en el registro',
                                @Html.Raw(JsonSerializer.Serialize(TempData["RegisterError"]?.ToString())));
                </text>
            }
            });

        // ── Validación en cliente ──
        document.getElementById('registerForm').addEventListener('submit', function(e) {
            var email = document.querySelector('[name="Input.Email"]').value.trim();
            var pass = document.getElementById('pwInput').value;
            var conf = document.getElementById('cfInput').value;

            if (!email || !pass || !conf) {
                e.preventDefault();
                showToast('warning', 'Campos requeridos',
                    'Por favor completa todos los campos antes de continuar.');
                return;
            }
            if (pass !== conf) {
                e.preventDefault();
                showToast('error', 'Contraseñas no coinciden',
                    'Asegúrate de escribir la misma contraseña en ambos campos.');
                return;
            }
            if (pass.length < 6) {
                e.preventDefault();
                showToast('warning', 'Contraseña muy corta',
                    'La contraseña debe tener al menos 6 caracteres.');
            }
        });
    </script>
}
