@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Cambiar contraseña";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=DM+Mono:wght@400;500&family=Fraunces:opsz,wght@9..144,700&display=swap');

    :root {
        --g50:#f0f9f4; --g100:#d4eddf; --g200:#a8dbbe; --g400:#4db37a;
        --g600:#2d7d52; --g800:#1a4f33; --accent:#3a9e6a;
        --text:#111827; --text2:#374151; --muted:#6b7280;
        --border:#e5e7eb; --surface:#f9fafb;
        --font-display:'Fraunces',serif;
        --font-body:'DM Sans',sans-serif;
        --font-mono:'DM Mono',monospace;
    }

    .page-header { margin-bottom: 28px; }
    .eyebrow {
        font-family: var(--font-mono); font-size: .68rem; letter-spacing: .16em;
        text-transform: uppercase; color: var(--accent); font-weight: 500; margin-bottom: 4px;
    }
    .page-header h1 {
        font-family: var(--font-display); font-size: 1.85rem; color: var(--text);
        font-weight: 700; letter-spacing: -.02em; margin-bottom: 4px; line-height: 1.15;
    }
    .page-header .sub { font-family: var(--font-body); color: var(--muted); font-size: .875rem; margin-bottom: 14px; }
    .divider-green { width: 36px; height: 3px; background: var(--g400); border-radius: 2px; margin-bottom: 28px; }

    .manage-layout { display: grid; grid-template-columns: 210px 1fr; gap: 22px; align-items: start; }

    /* Nav lateral */
    .account-nav { background: #fff; border: 1px solid var(--border); border-radius: 14px; overflow: hidden; position: sticky; top: 24px; }
    .account-nav-header { padding: 13px 16px; background: var(--g800); display: flex; align-items: center; gap: 10px; }
    .account-nav-header .anav-icon { width: 30px; height: 30px; border-radius: 7px; background: rgba(255,255,255,.12); display: flex; align-items: center; justify-content: center; color: rgba(255,255,255,.85); font-size: .85rem; }
    .account-nav-header span { font-family: var(--font-display); font-size: .88rem; color: #fff; font-weight: 700; }
    .account-nav ul { list-style: none; margin: 0; padding: 6px 0; }
    .account-nav ul li a { display: flex; align-items: center; gap: 10px; padding: 9px 16px; font-family: var(--font-body); font-size: .845rem; font-weight: 400; color: var(--text2); text-decoration: none; border-left: 2px solid transparent; transition: background .12s, color .12s; }
    .account-nav ul li a i { width: 15px; text-align: center; font-size: .78rem; color: var(--muted); flex-shrink: 0; transition: color .12s; }
    .account-nav ul li a:hover { background: var(--g50); color: var(--g600); text-decoration: none; }
    .account-nav ul li a:hover i { color: var(--accent); }
    .account-nav ul li a.active { background: var(--g50); color: var(--g800); border-left-color: var(--g400); font-weight: 500; }
    .account-nav ul li a.active i { color: var(--accent); }
    .account-nav ul li.sep { height: 1px; background: var(--border); margin: 5px 12px; }

    /* Form card */
    .form-card { background: #fff; border-radius: 14px; border: 1px solid var(--border); overflow: hidden; }
    .form-card-header { padding: 16px 22px; background: var(--g800); display: flex; align-items: center; gap: 12px; }
    .form-card-header .header-icon { width: 36px; height: 36px; border-radius: 9px; background: rgba(255,255,255,.12); display: flex; align-items: center; justify-content: center; color: rgba(255,255,255,.85); font-size: 1rem; flex-shrink: 0; }
    .form-card-header h5 { font-family: var(--font-display); font-size: 1rem; color: #fff; font-weight: 700; margin: 0; }
    .form-card-header p { font-family: var(--font-body); font-size: .72rem; color: rgba(255,255,255,.5); margin: 2px 0 0; }
    .form-card-body { padding: 24px 26px; }

    /* Fields */
    .field-group { margin-bottom: 18px; }
    .field-label { display: block; font-family: var(--font-body); font-size: .78rem; font-weight: 500; color: var(--text2); margin-bottom: 5px; }
    .field-wrap { position: relative; }
    .field-icon { position: absolute; left: 13px; top: 50%; transform: translateY(-50%); color: var(--muted); font-size: .8rem; pointer-events: none; }
    .form-control-custom {
        width: 100%; padding: 9px 13px 9px 38px;
        border: 1.5px solid var(--border); border-radius: 8px;
        font-family: var(--font-body); font-size: .875rem;
        color: var(--text); background: var(--surface);
        transition: border-color .15s, box-shadow .15s; outline: none;
    }
    .form-control-custom:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(58,158,106,.1); background: #fff; }

    /* Toggle mostrar contraseña */
    .pw-toggle { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; color: var(--muted); cursor: pointer; font-size: .8rem; padding: 0; transition: color .15s; }
    .pw-toggle:hover { color: var(--accent); }
    .form-control-pw { padding-right: 38px; }

    /* Barra de seguridad */
    .strength-wrap { margin-top: 8px; }
    .strength-bars { display: flex; gap: 4px; }
    .strength-seg { flex: 1; height: 3px; border-radius: 2px; background: var(--border); transition: background .3s; }
    .strength-lbl { font-family: var(--font-mono); font-size: .7rem; color: var(--muted); margin-top: 5px; }

    .field-hint { font-family: var(--font-body); font-size: .72rem; color: var(--muted); margin-top: 4px; }
    .text-danger { font-size: .77rem; color: #dc2626; margin-top: 3px; display: block; font-family: var(--font-body); }

    /* Info box */
    .info-box { background: var(--g50); border: 1px solid var(--g100); border-radius: 10px; padding: 13px 16px; display: flex; align-items: flex-start; gap: 11px; margin-bottom: 22px; }
    .info-box i { color: var(--accent); font-size: .9rem; margin-top: 1px; flex-shrink: 0; }
    .info-box p { font-family: var(--font-body); font-size: .82rem; color: var(--g600); margin: 0; line-height: 1.5; }

    .btn-save { display: inline-flex; align-items: center; gap: 8px; padding: 10px 24px; background: var(--accent); color: #fff; border: none; border-radius: 8px; font-family: var(--font-body); font-size: .875rem; font-weight: 600; cursor: pointer; transition: background .15s; }
    .btn-save:hover { background: var(--g600); }

    @@media (max-width:720px) { .manage-layout { grid-template-columns: 1fr; } .account-nav { position: static; } }
</style>

<div class="page-header">
    <div class="eyebrow">Cuenta</div>
    <h1>Cambiar contraseña</h1>
    <p class="sub">Actualiza tu contraseña de acceso al panel</p>
    <div class="divider-green"></div>
</div>

<div class="manage-layout">

    <!-- NAV LATERAL -->
    <div class="account-nav">
        <div class="account-nav-header">
            <div class="anav-icon"><i class="fas fa-user-cog"></i></div>
            <span>Cuenta</span>
        </div>
        <ul>
            <li><a class="@ManageNavPages.IndexNavClass(ViewContext)" asp-page="./Index"><i class="fas fa-user"></i> Perfil</a></li>
            <li><a class="@ManageNavPages.EmailNavClass(ViewContext)" asp-page="./Email"><i class="fas fa-envelope"></i> Correo</a></li>
            <li><a class="@ManageNavPages.ChangePasswordNavClass(ViewContext)" asp-page="./ChangePassword"><i class="fas fa-lock"></i> Contraseña</a></li>
            <li class="sep"></li>
            <li><a class="@ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext)" asp-page="./TwoFactorAuthentication"><i class="fas fa-shield-alt"></i> Doble factor</a></li>
            <li><a class="@ManageNavPages.PersonalDataNavClass(ViewContext)" asp-page="./PersonalData"><i class="fas fa-database"></i> Datos personales</a></li>
        </ul>
    </div>

    <!-- FORM CARD -->
    <div class="form-card">
        <div class="form-card-header">
            <div class="header-icon"><i class="fas fa-key"></i></div>
            <div>
                <h5>Cambiar contraseña</h5>
                <p>Ingresa tu contraseña actual y la nueva</p>
            </div>
        </div>
        <div class="form-card-body">

            <partial name="_StatusMessage" for="StatusMessage" />

            <div class="info-box">
                <i class="fas fa-circle-info"></i>
                <p>Usa una contraseña de al menos 6 caracteres combinando letras mayúsculas, minúsculas y números para mayor seguridad.</p>
            </div>

            <form id="change-password-form" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom:14px;"></div>

                <div class="field-group">
                    <label asp-for="Input.OldPassword" class="field-label"></label>
                    <div class="field-wrap">
                        <i class="fas fa-lock field-icon"></i>
                        <input asp-for="Input.OldPassword" class="form-control-custom form-control-pw"
                               id="oldPassword" placeholder="Tu contraseña actual" />
                        <button type="button" class="pw-toggle" onclick="togglePw('oldPassword', this)">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
                </div>

                <div class="field-group">
                    <label asp-for="Input.NewPassword" class="field-label"></label>
                    <div class="field-wrap">
                        <i class="fas fa-lock field-icon"></i>
                        <input asp-for="Input.NewPassword" class="form-control-custom form-control-pw"
                               id="newPassword" placeholder="Nueva contraseña" />
                        <button type="button" class="pw-toggle" onclick="togglePw('newPassword', this)">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                    <!-- barra de seguridad -->
                    <div class="strength-wrap">
                        <div class="strength-bars">
                            <div class="strength-seg" id="seg1"></div>
                            <div class="strength-seg" id="seg2"></div>
                            <div class="strength-seg" id="seg3"></div>
                            <div class="strength-seg" id="seg4"></div>
                        </div>
                        <div class="strength-lbl" id="strengthLabel"></div>
                    </div>
                </div>

                <div class="field-group">
                    <label asp-for="Input.ConfirmPassword" class="field-label"></label>
                    <div class="field-wrap">
                        <i class="fas fa-lock field-icon"></i>
                        <input asp-for="Input.ConfirmPassword" class="form-control-custom form-control-pw"
                               id="confirmPassword" placeholder="Repite la nueva contraseña" />
                        <button type="button" class="pw-toggle" onclick="togglePw('confirmPassword', this)">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    <div class="field-hint" id="matchHint"></div>
                </div>

                <div class="text-end mt-3">
                    <button type="submit" class="btn-save">
                        <i class="fas fa-key"></i>
                        Actualizar contraseña
                    </button>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
    function togglePw(inputId, btn) {
        var input = document.getElementById(inputId);
        var icon  = btn.querySelector('i');
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.replace('fa-eye', 'fa-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.replace('fa-eye-slash', 'fa-eye');
        }
    }

    var pwColors = ['#dc2626','#d97706','#16a34a','#0891b2'];
    var pwLabels = ['Muy débil','Débil','Buena','Muy fuerte'];

    document.getElementById('newPassword').addEventListener('input', function () {
        var v = this.value, score = 0;
        if (v.length >= 6)  score++;
        if (v.length >= 10) score++;
        if (/[A-Z]/.test(v) && /[0-9]/.test(v)) score++;
        if (/[^A-Za-z0-9]/.test(v)) score++;
        for (var i = 1; i <= 4; i++) {
            document.getElementById('seg' + i).style.background = i <= score ? pwColors[score - 1] : '#e5e7eb';
        }
        var lbl = document.getElementById('strengthLabel');
        lbl.textContent = v.length > 0 ? pwLabels[Math.max(0, score - 1)] : '';
        lbl.style.color  = v.length > 0 ? pwColors[Math.max(0, score - 1)] : '';
    });

    document.getElementById('confirmPassword').addEventListener('input', function () {
        var hint = document.getElementById('matchHint');
        var pw   = document.getElementById('newPassword').value;
        if (this.value.length === 0) { hint.textContent = ''; return; }
        if (this.value === pw) {
            hint.textContent = '✓ Las contraseñas coinciden';
            hint.style.color = '#16a34a';
        } else {
            hint.textContent = '✗ Las contraseñas no coinciden';
            hint.style.color = '#dc2626';
        }
    });
</script>
}
