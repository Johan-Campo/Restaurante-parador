@page
@model EmailModel
@{
    ViewData["Title"] = "Gestionar correo";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<style>
    :root {
        --g50:   #f5e8d0; --g100: #e8d0a0; --g200: #d4b87a; --g400: #b5873f;
        --g600:  #8a6230; --g800: #1a2820; --accent: #b5873f;
        --text:  #1c1a17; --text2: #3d3a34; --muted: #8b8680;
        --border:#e0d8cc; --surface: #faf7f2;
        --font-display: 'Playfair Display', serif;
        --font-body:    'Inter', sans-serif;
        --font-mono:    'DM Mono', monospace;
    }

    .page-header { margin-bottom: 28px; }
    .eyebrow { font-family: var(--font-mono); font-size: .68rem; letter-spacing: .16em; text-transform: uppercase; color: var(--accent); font-weight: 500; margin-bottom: 4px; }
    .page-header h1 { font-family: var(--font-display); font-size: 1.85rem; color: var(--text); font-weight: 700; letter-spacing: -.02em; margin-bottom: 4px; line-height: 1.15; }
    .page-header .sub { font-family: var(--font-body); color: var(--muted); font-size: .875rem; margin-bottom: 14px; }
    .divider-green { width: 36px; height: 3px; background: var(--g400); border-radius: 2px; margin-bottom: 28px; }

    .manage-layout { display: grid; grid-template-columns: 210px 1fr; gap: 22px; align-items: start; }

    .account-nav { background: #fff; border: 1px solid var(--border); border-radius: 14px; overflow: hidden; position: sticky; top: 24px; }
    .account-nav-header { padding: 13px 16px; background: var(--g800); display: flex; align-items: center; gap: 10px; }
    .account-nav-header .anav-icon { width: 30px; height: 30px; border-radius: 7px; background: rgba(255,255,255,.12); display: flex; align-items: center; justify-content: center; color: rgba(255,255,255,.85); font-size: .85rem; }
    .account-nav-header span { font-family: var(--font-display); font-size: .88rem; color: #fff; font-weight: 700; }
    .account-nav ul { list-style: none; margin: 0; padding: 6px 0; }
    .account-nav ul li a { display: flex; align-items: center; gap: 10px; padding: 9px 16px; font-family: var(--font-body); font-size: .845rem; font-weight: 400; color: var(--text2); text-decoration: none; border-left: 2px solid transparent; transition: background .12s, color .12s; }
    .account-nav ul li a i { width: 15px; text-align: center; font-size: .78rem; color: var(--muted); flex-shrink: 0; transition: color .12s; }
    .account-nav ul li a:hover { background: var(--g50); color: var(--g600); text-decoration: none; }
    .account-nav ul li a:hover i { color: var(--accent); }
    .account-nav ul li a.active { background: var(--g50); color: var(--g800); border-left-color: var(--g400); font-weight: 500; }
    .account-nav ul li a.active i { color: var(--accent); }
    .account-nav ul li.sep { height: 1px; background: var(--border); margin: 5px 12px; }

    .form-card { background: #fff; border-radius: 14px; border: 1px solid var(--border); overflow: hidden; margin-bottom: 18px; }
    .form-card-header { padding: 16px 22px; background: var(--g800); display: flex; align-items: center; gap: 12px; }
    .form-card-header .header-icon { width: 36px; height: 36px; border-radius: 9px; background: rgba(255,255,255,.12); display: flex; align-items: center; justify-content: center; color: rgba(255,255,255,.85); font-size: 1rem; flex-shrink: 0; }
    .form-card-header h5 { font-family: var(--font-display); font-size: 1rem; color: #fff; font-weight: 700; margin: 0; }
    .form-card-header p { font-family: var(--font-body); font-size: .72rem; color: rgba(255,255,255,.5); margin: 2px 0 0; }
    .form-card-body { padding: 24px 26px; }

    .field-group { margin-bottom: 18px; }
    .field-label { display: block; font-family: var(--font-body); font-size: .78rem; font-weight: 500; color: var(--text2); margin-bottom: 5px; }
    .field-wrap { position: relative; }
    .field-icon { position: absolute; left: 13px; top: 50%; transform: translateY(-50%); color: var(--muted); font-size: .8rem; pointer-events: none; }
    .form-control-custom { width: 100%; padding: 9px 13px 9px 38px; border: 1.5px solid var(--border); border-radius: 8px; font-family: var(--font-body); font-size: .875rem; color: var(--text); background: var(--surface); transition: border-color .15s, box-shadow .15s; outline: none; }
    .form-control-custom:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(181,135,63,.1); background: #fff; }
    .form-control-custom:disabled { background: #f0f2f0; color: #999; cursor: not-allowed; border-color: #e8ebe8; }

    .text-danger { font-size: .77rem; color: #dc2626; margin-top: 3px; display: block; font-family: var(--font-body); }

    /* badge de verificación */
    .verified-badge { display: inline-flex; align-items: center; gap: 6px; background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 20px; padding: 4px 12px; font-family: var(--font-mono); font-size: .7rem; color: #16a34a; font-weight: 500; margin-left: 8px; }
    .unverified-badge { display: inline-flex; align-items: center; gap: 6px; background: #fef3c7; border: 1px solid #fde68a; border-radius: 20px; padding: 4px 12px; font-family: var(--font-mono); font-size: .7rem; color: #92400e; font-weight: 500; margin-left: 8px; }

    /* email actual display */
    .current-email-row { display: flex; align-items: center; padding: 11px 0; border-bottom: 1px solid var(--border); margin-bottom: 20px; flex-wrap: wrap; gap: 8px; }
    .current-email-label { font-family: var(--font-mono); font-size: .65rem; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); margin-bottom: 3px; }
    .current-email-value { font-family: var(--font-body); font-size: .9rem; color: var(--text); font-weight: 500; }

    .btn-save { display: inline-flex; align-items: center; gap: 8px; padding: 10px 24px; background: var(--accent); color: #fff; border: none; border-radius: 8px; font-family: var(--font-body); font-size: .875rem; font-weight: 600; cursor: pointer; transition: background .15s; }
    .btn-save:hover { background: var(--g600); }
    .btn-outline { display: inline-flex; align-items: center; gap: 8px; padding: 10px 20px; background: #fff; color: var(--text2); border: 1px solid var(--border); border-radius: 8px; font-family: var(--font-body); font-size: .875rem; font-weight: 500; cursor: pointer; transition: all .15s; text-decoration: none; }
    .btn-outline:hover { border-color: var(--g200); color: var(--g800); }

    @@media (max-width:720px) { .manage-layout { grid-template-columns: 1fr; } .account-nav { position: static; } }
</style>

<div class="page-header">
    <div class="eyebrow">Cuenta</div>
    <h1>Gestionar correo</h1>
    <p class="sub">Actualiza y verifica tu dirección de correo electrónico</p>
    <div class="divider-green"></div>
</div>

<div class="manage-layout">

    <div class="account-nav">
        <div class="account-nav-header">
            <div class="anav-icon"><i class="fas fa-user-cog"></i></div>
            <span>Cuenta</span>
        </div>
        <ul>
            <li><a class="@ManageNavPages.IndexNavClass(ViewContext)" asp-page="./Index"><i class="fas fa-user"></i> Perfil</a></li>
            <li><a class="@ManageNavPages.EmailNavClass(ViewContext)" asp-page="./Email"><i class="fas fa-envelope"></i> Correo</a></li>
            <li><a class="@ManageNavPages.ChangePasswordNavClass(ViewContext)" asp-page="./ChangePassword"><i class="fas fa-lock"></i> Contraseña</a></li>
            <li class="sep"></li>
            <li><a class="@ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext)" asp-page="./TwoFactorAuthentication"><i class="fas fa-shield-alt"></i> Doble factor</a></li>
            <li><a class="@ManageNavPages.PersonalDataNavClass(ViewContext)" asp-page="./PersonalData"><i class="fas fa-database"></i> Datos personales</a></li>
        </ul>
    </div>

    <div>
        <!-- Card correo actual -->
        <div class="form-card">
            <div class="form-card-header">
                <div class="header-icon"><i class="fas fa-envelope"></i></div>
                <div>
                    <h5>Correo actual</h5>
                    <p>Estado de verificación de tu correo</p>
                </div>
            </div>
            <div class="form-card-body">
                <partial name="_StatusMessage" for="StatusMessage" />

                <div class="current-email-row">
                    <div>
                        <div class="current-email-label">Correo registrado</div>
                        <div class="current-email-value">@Model.Email</div>
                    </div>
                    @if (Model.IsEmailConfirmed)
                    {
                        <span class="verified-badge"><i class="fas fa-circle-check"></i> Verificado</span>
                    }
                    else
                    {
                        <span class="unverified-badge"><i class="fas fa-triangle-exclamation"></i> Sin verificar</span>
                    }
                </div>

                @if (!Model.IsEmailConfirmed)
                {
                    <form id="send-verification-form" method="post" asp-page-handler="SendVerificationEmail">
                        <button type="submit" class="btn-outline">
                            <i class="fas fa-paper-plane"></i>
                            Enviar correo de verificación
                        </button>
                    </form>
                }
            </div>
        </div>

        <!-- Card cambiar correo -->
        <div class="form-card">
            <div class="form-card-header">
                <div class="header-icon"><i class="fas fa-at"></i></div>
                <div>
                    <h5>Cambiar correo</h5>
                    <p>Introduce el nuevo correo que quieres usar</p>
                </div>
            </div>
            <div class="form-card-body">
                <form id="change-email-form" method="post" asp-page-handler="ChangeEmail">
                    <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom:14px;"></div>

                    <div class="field-group">
                        <label asp-for="Input.NewEmail" class="field-label"></label>
                        <div class="field-wrap">
                            <i class="fas fa-envelope field-icon"></i>
                            <input asp-for="Input.NewEmail" class="form-control-custom"
                                   placeholder="nuevo@correo.com" autocomplete="email" />
                        </div>
                        <span asp-validation-for="Input.NewEmail" class="text-danger"></span>
                    </div>

                    <div class="text-end">
                        <button type="submit" class="btn-save">
                            <i class="fas fa-envelope-circle-check"></i>
                            Cambiar correo
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
