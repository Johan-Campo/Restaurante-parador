@model IEnumerable<DropDownsAnidadosMvc.Models.Categoria>
@{
    ViewData["Title"] = "Categorías";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=DM+Mono:wght@400;500&family=Fraunces:ital,wght@0,700;1,700&display=swap');

    :root {
        --g50:    #f0f9f4;
        --g100:   #d4eddf;
        --g200:   #a8dbbe;
        --g400:   #4db37a;
        --g600:   #2d7d52;
        --g800:   #1a4f33;
        --accent: #3a9e6a;
        --text:   #1e2d24;
        --muted:  #6b7c71;
        --border: #dde8e1;
        --surface:#f5f7f5;
        --font-display: 'Fraunces', serif;
        --font-body:    'DM Sans', sans-serif;
        --font-mono:    'DM Mono', monospace;
    }

    body { font-family: var(--font-body); }

    .page-header        { margin-bottom: 28px; }
    .eyebrow {
        font-family: var(--font-mono);
        font-size: 0.68rem; letter-spacing: 0.16em;
        text-transform: uppercase; color: var(--accent);
        font-weight: 500; margin-bottom: 5px;
    }
    .page-header h1 {
        font-family: var(--font-display);
        font-size: 1.95rem; color: var(--text); font-weight: 700; margin-bottom: 5px;
    }
    .page-header .sub {
        font-family: var(--font-body);
        color: var(--muted); font-size: 0.875rem; margin-bottom: 14px;
    }
    .divider-green { width: 40px; height: 3px; background: var(--g400); border-radius: 2px; margin-bottom: 24px; }

    .toolbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; flex-wrap: wrap; gap: 10px; }
    .count-badge {
        display: inline-flex; align-items: center; gap: 6px;
        background: var(--g50); border: 1px solid var(--g100);
        border-radius: 20px; padding: 5px 12px;
        font-family: var(--font-body);
        font-size: 0.78rem; color: var(--g600); font-weight: 500;
    }
    .btn-new {
        display: inline-flex; align-items: center; gap: 7px;
        padding: 9px 20px; background: var(--accent); color: #fff;
        border-radius: 8px; font-family: var(--font-body);
        font-size: 0.855rem; font-weight: 500;
        text-decoration: none; transition: background 0.15s;
    }
    .btn-new:hover { background: var(--g600); color: #fff; text-decoration: none; }

    .table-card { background: #fff; border-radius: 14px; border: 1px solid var(--border); overflow: hidden; }
    .table-card-header { padding: 16px 22px; background: var(--g800); display: flex; align-items: center; gap: 11px; }
    .table-card-header .t-icon {
        width: 34px; height: 34px; border-radius: 8px;
        background: rgba(255,255,255,0.12);
        display: flex; align-items: center; justify-content: center;
        color: rgba(255,255,255,0.85); font-size: 0.95rem; flex-shrink: 0;
    }
    .table-card-header h5 {
        font-family: var(--font-display);
        font-size: 1rem; color: #fff; margin: 0; font-weight: 700;
    }
    .table-card-header p {
        font-family: var(--font-body);
        font-size: 0.72rem; color: rgba(255,255,255,0.5); margin: 1px 0 0;
    }

    .data-table { width: 100%; border-collapse: collapse; }
    .data-table thead th {
        padding: 11px 20px;
        font-family: var(--font-mono);
        font-size: 0.7rem; font-weight: 500;
        letter-spacing: 0.08em; text-transform: uppercase;
        color: var(--muted); background: var(--surface);
        border-bottom: 1px solid var(--border); text-align: left;
    }
    .data-table tbody tr { border-bottom: 1px solid var(--border); transition: background 0.12s; }
    .data-table tbody tr:last-child { border-bottom: none; }
    .data-table tbody tr:hover { background: var(--g50); }
    .data-table tbody td {
        padding: 13px 20px;
        font-family: var(--font-body);
        font-size: 0.875rem; color: var(--text); vertical-align: middle;
    }

    .id-badge {
        display: inline-flex; align-items: center; justify-content: center;
        width: 28px; height: 28px; border-radius: 7px;
        background: var(--g50); border: 1px solid var(--g100);
        font-family: var(--font-mono);
        font-size: 0.75rem; font-weight: 500; color: var(--g600);
    }
    .name-cell { display: flex; align-items: center; gap: 10px; }
    .name-avatar {
        width: 30px; height: 30px; border-radius: 8px; background: var(--g100);
        display: flex; align-items: center; justify-content: center;
        font-family: var(--font-body);
        font-size: 0.8rem; color: var(--g800); font-weight: 600; flex-shrink: 0;
    }
    .sucursal-pill {
        display: inline-flex; align-items: center; gap: 5px;
        background: var(--g50); border: 1px solid var(--g100);
        border-radius: 6px; padding: 4px 10px;
        font-family: var(--font-body);
        font-size: 0.78rem; color: var(--g600); font-weight: 500;
    }
    .actions-cell { display: flex; align-items: center; gap: 6px; }
    .action-btn {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 5px 11px; border-radius: 6px;
        font-family: var(--font-body);
        font-size: 0.78rem; font-weight: 500;
        text-decoration: none; transition: all 0.15s; border: 1px solid transparent;
    }
    .action-btn.edit   { background: var(--g50);   border-color: var(--g100);  color: var(--g600); }
    .action-btn.edit:hover   { background: var(--g100); color: var(--g800); text-decoration: none; }
    .action-btn.detail { background: #f0f4ff; border-color: #c7d4f7; color: #3b5ec4; }
    .action-btn.detail:hover { background: #dde6ff; color: #2945a8; text-decoration: none; }
    .action-btn.delete { background: #fef2f2; border-color: #fecaca; color: #dc2626; }
    .action-btn.delete:hover { background: #fee2e2; color: #b91c1c; text-decoration: none; }

    .empty-state { padding: 56px 24px; text-align: center; }
    .empty-icon {
        width: 56px; height: 56px; border-radius: 14px;
        background: var(--g50); border: 1px solid var(--g100);
        display: flex; align-items: center; justify-content: center;
        font-size: 1.4rem; color: var(--g400); margin: 0 auto 14px;
    }
    .empty-state h6 { font-family: var(--font-body); color: var(--text); font-weight: 600; margin-bottom: 5px; }
    .empty-state p  { font-family: var(--font-body); font-size: 0.85rem; color: var(--muted); }
</style>

<div class="page-header">
    <div class="eyebrow">Gestión</div>
    <h1>Categorías</h1>
    <p class="sub">Administra las categorías de productos por sucursal</p>
    <div class="divider-green"></div>
</div>

<div class="toolbar">
    <div class="count-badge">
        <i class="fas fa-tags" style="font-size:0.75rem;"></i>
        @Model.Count() categoría(s) registrada(s)
    </div>
    <a asp-action="Create" class="btn-new">
        <i class="fas fa-plus"></i> Nueva categoría
    </a>
</div>

<div class="table-card">
    <div class="table-card-header">
        <div class="t-icon"><i class="fas fa-tags"></i></div>
        <div>
            <h5>Lista de categorías</h5>
            <p>Todas las categorías del sistema</p>
        </div>
    </div>

    @if (Model.Any())
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th style="width:60px;">ID</th>
                    <th>Nombre</th>
                    <th>Sucursal</th>
                    <th style="width:200px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Count(); i++)
                {
                    var item = Model.ElementAt(i);

                    <tr>
                           <td><span class="id-badge">@(i + 1)</span></td>
                        <td>
                            <div class="name-cell">
                                <div class="name-avatar">@(!string.IsNullOrEmpty(item.Nombre) ? item.Nombre[0].ToString().ToUpper() : "?")</div>
                                <span style="font-weight:500;">@item.Nombre</span>
                            </div>
                        </td>
                        <td>
                            <span class="sucursal-pill">
                                <i class="fas fa-store" style="font-size:0.68rem;"></i>
                                @Html.DisplayFor(m => item.Sucursal.Nombre)
                            </span>
                        </td>
                        <td>
                            <div class="actions-cell">
                                <a asp-action="Edit"    asp-route-id="@item.Id" class="action-btn edit">   <i class="fas fa-pen"   style="font-size:0.7rem;"></i> Editar</a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="action-btn detail"><i class="fas fa-eye"   style="font-size:0.7rem;"></i> Detalle</a>
                                <a asp-action="Delete"  asp-route-id="@item.Id" class="action-btn delete"><i class="fas fa-trash" style="font-size:0.7rem;"></i> Borrar</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon"><i class="fas fa-tags"></i></div>
            <h6>Sin categorías registradas</h6>
            <p>Crea tu primera categoría para comenzar</p>
        </div>
    }
</div>
