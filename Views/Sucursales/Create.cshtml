@model DropDownsAnidadosMvc.Models.Sucursal
@{ ViewData["Title"] = "Nueva sucursal"; }

<style>
    :root{--g50:#f5e8d0;--g100:#e8d0a0;--g200:#d4b87a;--g400:#b5873f;--g600:#8a6230;--g800:#1a2820;--accent:#b5873f;--text:#1c1a17;--text2:#3d3a34;--muted:#8b8680;--border:#e0d8cc;--surface:#faf7f2;}
    .page-header{margin-bottom:24px;} .eyebrow{font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;color:var(--accent);font-weight:600;margin-bottom:4px;} .page-header h1{font-size:1.6rem;color:var(--text);font-weight:700;letter-spacing:-.02em;margin-bottom:4px;} .page-header .sub{color:var(--muted);font-size:.875rem;margin-bottom:12px;} .divider-green{width:36px;height:3px;background:var(--g400);border-radius:2px;margin-bottom:22px;}
    .content-card{background:#fff;border-radius:14px;border:1px solid var(--border);overflow:hidden;max-width:520px;}
    .card-head{padding:15px 22px;background:var(--g800);display:flex;align-items:center;gap:11px;} .card-head-icon{width:34px;height:34px;border-radius:8px;background:rgba(255,255,255,.12);display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,.85);font-size:.95rem;flex-shrink:0;} .card-head h5{font-size:.95rem;color:#fff;margin:0;font-weight:600;} .card-head p{font-size:.72rem;color:rgba(255,255,255,.5);margin:1px 0 0;}
    .card-body{padding:22px 24px;}
    .field-group{margin-bottom:16px;} .field-label{display:block;font-size:.78rem;font-weight:500;color:var(--text2);margin-bottom:5px;} .field-input{width:100%;padding:9px 13px;border:1.5px solid var(--border);border-radius:8px;font-family:'Inter',sans-serif;font-size:.875rem;color:var(--text);background:var(--surface);outline:none;transition:border-color .15s,box-shadow .15s;} .field-input:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(181,135,63,.1);background:#fff;}
    .text-danger{font-size:.77rem;color:#dc2626;margin-top:3px;display:block;}
    .btn-primary-custom{display:inline-flex;align-items:center;gap:7px;padding:9px 20px;background:var(--accent);color:#fff;border:none;border-radius:8px;font-family:'Inter',sans-serif;font-size:.875rem;font-weight:600;cursor:pointer;transition:background .15s;} .btn-primary-custom:hover{background:var(--g600);}
    .btn-back{display:inline-flex;align-items:center;gap:6px;padding:9px 16px;background:#fff;color:var(--muted);border:1px solid var(--border);border-radius:8px;font-family:'Inter',sans-serif;font-size:.855rem;font-weight:500;text-decoration:none;transition:all .15s;} .btn-back:hover{border-color:var(--g200);color:var(--text);text-decoration:none;}
    .btn-row{display:flex;align-items:center;gap:10px;margin-top:4px;}
</style>

<div class="page-header">
    <div class="eyebrow">Sucursales</div>
    <h1>Nueva sucursal</h1>
    <p class="sub">Completa los datos para registrar una nueva sucursal</p>
    <div class="divider-green"></div>
</div>

<div class="content-card">
    <div class="card-head">
        <div class="card-head-icon"><i class="fas fa-store"></i></div>
        <div><h5>Datos de la sucursal</h5><p>Todos los campos son obligatorios</p></div>
    </div>
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom:12px;"></div>

            <div class="field-group">
                <label asp-for="Nombre" class="field-label"></label>
                <input asp-for="Nombre" class="field-input" placeholder="Ej: Sede Centro" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="field-group">
                <label asp-for="Direccion" class="field-label"></label>
                <input asp-for="Direccion" class="field-input" placeholder="Ej: Calle 15 # 8-42" />
                <span asp-validation-for="Direccion" class="text-danger"></span>
            </div>

            <div class="btn-row">
                <button type="submit" class="btn-primary-custom">
                    <i class="fas fa-plus"></i> Crear sucursal
                </button>
                <a asp-action="Index" class="btn-back">
                    <i class="fas fa-arrow-left"></i> Volver
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
