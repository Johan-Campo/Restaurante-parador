        <!DOCTYPE html>
        <html lang="es">
        <head>
            <meta charset="utf-8" />
            <meta name="viewport" content="width=device-width, initial-scale=1.0" />
            <title>@ViewData["Title"] - Estadero Parador Turístico</title>

            <link rel="preconnect" href="https://fonts.googleapis.com">
            <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
            <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
            <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
            <link rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />

            <style>
                /* ─────────────────────────────────────────────
                   TOKENS GLOBALES
                ───────────────────────────────────────────── */
                :root {
                    --g400: #4db37a;
                    --g600: #2d7d52;
                    --g800: #1a4f33;
                    --accent: #3a9e6a;
                    /* cyan como acento de contraste */
                    --cyan:       #0891b2;
                    --cyan-light: #06b6d4;
                    --cyan-soft:  #ecfeff;
                    --cyan-border:#a5f3fc;
                    --rose:  #e11d48;
                    --text:  #111827;
                    --text2: #374151;
                    --muted: #6b7280;
                    --border:#e5e7eb;
                    --surface:#f9fafb;
                }

                *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

                body {
                    font-family: 'Inter', sans-serif;
                    min-height: 100vh;
                    background: var(--surface);
                    display: flex;
                    flex-direction: column;
                }

                @@keyframes toastIn  { from { opacity:0; transform:translateX(40px) } to { opacity:1; transform:translateX(0) } }
                @@keyframes toastOut { from { opacity:1; transform:translateX(0) }    to { opacity:0; transform:translateX(40px) } }

                /* ─────────────────────────────────────────────
                   SHELL AUTH (compartido por Login y Register)
                ───────────────────────────────────────────── */
                .auth-shell { min-height: 100vh; display: flex; }

                /* ── Panel izquierdo ── */
                .auth-panel {
                    width: 460px; flex-shrink: 0;
                    background: var(--g800);
                    display: flex; flex-direction: column; justify-content: space-between;
                    padding: 44px 48px;
                    position: relative; overflow: hidden;
                }

                /* ola decorativa de fondo (del SVG del delfín/restaurante) */
                .panel-bg-wave {
                    position: absolute; bottom: 0; left: 0; right: 0;
                    pointer-events: none; opacity: .15;
                }

                /* círculo decorativo cyan */
                .panel-circle-top {
                    position: absolute; top: -120px; right: -80px;
                    width: 340px; height: 340px; border-radius: 50%;
                    background: rgba(6,182,212,.12);
                    pointer-events: none;
                }

                .panel-circle-bot {
                    position: absolute; bottom: -80px; left: -60px;
                    width: 220px; height: 220px; border-radius: 50%;
                    background: rgba(6,182,212,.07);
                    pointer-events: none;
                }

                /* ── Logo compuesto (delfín + texto) ── */
                .panel-logo-wrap {
                    position: relative; z-index: 2;
                    display: flex; align-items: center; gap: 14px;
                    padding-bottom: 22px;
                    border-bottom: 1px solid rgba(255,255,255,.1);
                }

                /* cuadrado blanco que contiene el SVG del delfín */
                .logo-box {
                    width: 52px; height: 52px;
                    border-radius: 14px;
                    background: #fff;
                    display: flex; align-items: center; justify-content: center;
                    flex-shrink: 0;
                }

                .logo-brand   { font-size: .95rem; font-weight: 700; color: #fff; letter-spacing: -.02em; line-height: 1.25; }
                .logo-tagline { font-size: .68rem; color: rgba(255,255,255,.4); letter-spacing: .05em; margin-top: 3px; }

                /* ── Cuerpo del panel ── */
                .panel-body { position: relative; z-index: 2; }

                .panel-body h2 {
                    font-size: 1.7rem; font-weight: 700; color: #fff;
                    letter-spacing: -.03em; line-height: 1.2; margin-bottom: 10px;
                }

                .panel-desc {
                    font-size: .875rem; color: rgba(255,255,255,.5);
                    line-height: 1.65; margin-bottom: 28px;
                }

                /* feature chips — con acento cyan */
                .feat-chip {
                    display: flex; align-items: center; gap: 12px;
                    padding: 12px 16px; margin-bottom: 8px;
                    background: rgba(255,255,255,.06);
                    border: 1px solid rgba(255,255,255,.09);
                    border-radius: 12px;
                    font-size: .83rem; color: rgba(255,255,255,.75);
                }

                .feat-icon {
                    width: 30px; height: 30px; border-radius: 8px;
                    background: rgba(6,182,212,.2);
                    border: 1px solid rgba(6,182,212,.35);
                    display: flex; align-items: center; justify-content: center;
                    color: #67e8f9; font-size: .78rem; flex-shrink: 0;
                }

                /* pasos numerados (Register) */
                .step-item {
                    display: flex; align-items: flex-start; gap: 14px;
                    padding: 13px 0;
                    border-bottom: 1px solid rgba(255,255,255,.07);
                }
                .step-item:last-child { border-bottom: none; }

                .step-num {
                    width: 28px; height: 28px; border-radius: 50%;
                    background: rgba(6,182,212,.2);
                    border: 1px solid rgba(6,182,212,.45);
                    display: flex; align-items: center; justify-content: center;
                    font-size: .72rem; font-weight: 700; color: #67e8f9;
                    flex-shrink: 0; margin-top: 1px;
                }

                .step-text  { font-size: .82rem; color: rgba(255,255,255,.6); line-height: 1.4; }
                .step-title { font-weight: 700; color: rgba(255,255,255,.9); margin-bottom: 2px; font-size: .855rem; }

                .panel-footer {
                    font-size: .7rem; color: rgba(255,255,255,.22);
                    position: relative; z-index: 2;
                }

                /* ── Lado formulario ── */
                .auth-form-side {
                    flex: 1; display: flex; align-items: center; justify-content: center;
                    padding: 56px 40px; background: var(--surface);
                }

                .auth-box { width: 100%; max-width: 400px; }

                /* badge pill cyan */
                .auth-badge {
                    display: inline-flex; align-items: center; gap: 7px;
                    background: var(--cyan-soft);
                    border: 1px solid var(--cyan-border);
                    border-radius: 20px; padding: 5px 14px;
                    font-size: .73rem; color: var(--cyan); font-weight: 600;
                    margin-bottom: 20px; letter-spacing: .02em;
                }
                .auth-badge .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--cyan-light); flex-shrink: 0; }

                .auth-box-header { margin-bottom: 24px; }

                .auth-box-header h3 {
                    font-size: 1.5rem; font-weight: 700; color: var(--text);
                    letter-spacing: -.025em; margin-bottom: 5px;
                }

                .auth-box-header p { font-size: .855rem; color: var(--muted); }

                /* campos */
                .field-group { margin-bottom: 16px; }

                .field-label {
                    display: block; font-size: .77rem; font-weight: 600;
                    color: var(--text2); margin-bottom: 6px; letter-spacing: .01em;
                }

                .field-wrap { position: relative; }

                .field-input {
                    width: 100%; padding: 11px 14px 11px 40px;
                    border: 1.5px solid var(--border); border-radius: 9px;
                    font-family: 'Inter', sans-serif; font-size: .875rem;
                    color: var(--text); background: #fff; outline: none;
                    transition: border-color .15s, box-shadow .15s;
                }

                .field-input:focus {
                    border-color: var(--cyan-light);
                    box-shadow: 0 0 0 3px rgba(6,182,212,.12);
                }

                .field-icon {
                    position: absolute; left: 13px; top: 50%;
                    transform: translateY(-50%);
                    color: var(--muted); font-size: .8rem; pointer-events: none;
                }

                .text-danger { font-size: .76rem; color: #e11d48; margin-top: 4px; display: block; }

                /* remember */
                .remember-row { display: flex; align-items: center; gap: 8px; margin-bottom: 20px; }
                .remember-row input[type="checkbox"] { width: 15px; height: 15px; accent-color: var(--cyan); cursor: pointer; }
                .remember-row label { font-size: .82rem; color: var(--muted); cursor: pointer; margin: 0; }

                /* botón principal — cyan para contrastar con el verde */
                .btn-submit {
                    width: 100%; padding: 12px;
                    background: var(--cyan); color: #fff;
                    border: none; border-radius: 10px;
                    font-family: 'Inter', sans-serif; font-size: .9rem; font-weight: 700;
                    cursor: pointer; transition: background .15s, transform .1s;
                    display: flex; align-items: center; justify-content: center; gap: 8px;
                    margin-bottom: 18px; letter-spacing: .01em;
                }
                .btn-submit:hover  { background: #0e7490; }
                .btn-submit:active { transform: scale(.99); }

                /* divider */
                .auth-divider { display: flex; align-items: center; gap: 10px; margin: 0 0 14px; }
                .auth-divider::before, .auth-divider::after { content: ''; flex: 1; height: 1px; background: var(--border); }
                .auth-divider span { font-size: .74rem; color: var(--muted); white-space: nowrap; }

                .auth-link-row { text-align: center; font-size: .845rem; color: var(--muted); }
                .auth-link-row a { color: var(--g600); font-weight: 600; text-decoration: none; margin-left: 4px; }
                .auth-link-row a:hover { text-decoration: underline; }

                /* barra de seguridad (Register) */
                .strength-wrap { margin-top: 8px; }
                .strength-bars { display: flex; gap: 4px; }
                .strength-seg  { flex: 1; height: 3px; border-radius: 2px; background: var(--border); transition: background .3s; }
                .strength-lbl  { font-size: .72rem; color: var(--muted); margin-top: 5px; }

                .field-hint {
                    display: flex; align-items: center; gap: 5px;
                    font-size: .73rem; color: var(--muted); margin-top: 6px; line-height: 1.4;
                }
                .field-hint i { color: var(--cyan); font-size: .68rem; }

                @@media (max-width: 768px) { .auth-panel { display: none; } }
            </style>
        </head>
        <body>

        @RenderBody()

        <partial name="_Notification" />

        @await RenderSectionAsync("Scripts", required: false)
        <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
        <script>
        function showToast(type, title, message) {
            toastr.options = {
                "closeButton": true,
                "progressBar": true,
                "positionClass": "toast-top-right",
                "timeOut": "4000"
            };

            switch(type) {
                case 'success': toastr.success(message, title); break;
                case 'error': toastr.error(message, title); break;
                case 'warning': toastr.warning(message, title); break;
                case 'info': toastr.info(message, title); break;
            }
        }
    </script>
       </body>
        </html>
