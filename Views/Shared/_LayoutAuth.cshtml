        <!DOCTYPE html>
        <html lang="es">
        <head>
            <meta charset="utf-8" />
            <meta name="viewport" content="width=device-width, initial-scale=1.0" />
            <title>@ViewData["Title"] - Estadero Parador Turístico</title>

            <link rel="preconnect" href="https://fonts.googleapis.com">
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
            <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Inter:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
            <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
            <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
            <link rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />

            <style>
                :root {
                    --g50:   #f5e8d0;
                    --g100:  #e8d0a0;
                    --g200:  #d4b87a;
                    --g400:  #b5873f;
                    --g600:  #8a6230;
                    --g800:  #1a2820;
                    --accent:#b5873f;
                    --text:  #1c1a17;
                    --text2: #3d3a34;
                    --muted: #8b8680;
                    --border:#e0d8cc;
                    --surface:#faf7f2;
                    --font-display: 'Playfair Display', serif;
                    --font-body:    'Inter', sans-serif;
                    --font-mono:    'DM Mono', monospace;
                }

                *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

                body {
                    font-family: var(--font-body);
                    min-height: 100vh;
                    background: var(--surface);
                    display: flex;
                    flex-direction: column;
                }

                /* ── SHELL AUTH ── */
                .auth-shell { min-height: 100vh; display: flex; }

                /* ── Panel izquierdo ── */
                .auth-panel {
                    width: 460px; flex-shrink: 0;
                    background: var(--g800);
                    display: flex; flex-direction: column; justify-content: space-between;
                    padding: 44px 48px;
                    position: relative; overflow: hidden;
                }

                .panel-bg-wave {
                    position: absolute; bottom: 0; left: 0; right: 0;
                    pointer-events: none; opacity: .08;
                }

                .panel-circle-top {
                    position: absolute; top: -120px; right: -80px;
                    width: 340px; height: 340px; border-radius: 50%;
                    background: rgba(181,135,63,.1);
                    pointer-events: none;
                }

                .panel-circle-bot {
                    position: absolute; bottom: -80px; left: -60px;
                    width: 220px; height: 220px; border-radius: 50%;
                    background: rgba(181,135,63,.06);
                    pointer-events: none;
                }

                /* ── Logo ── */
                .panel-logo-wrap {
                    position: relative; z-index: 2;
                    display: flex; align-items: center; gap: 14px;
                    padding-bottom: 22px;
                    border-bottom: 1px solid rgba(255,255,255,.1);
                }

                .logo-box {
                    width: 52px; height: 52px;
                    border-radius: 14px;
                    background: #fff;
                    display: flex; align-items: center; justify-content: center;
                    flex-shrink: 0;
                }

                .logo-brand   { font-family: var(--font-display); font-size: .95rem; font-weight: 700; color: #fff; letter-spacing: -.02em; line-height: 1.25; }
                .logo-tagline { font-family: var(--font-mono); font-size: .68rem; color: rgba(255,255,255,.4); letter-spacing: .05em; margin-top: 3px; }

                /* ── Cuerpo del panel ── */
                .panel-body { position: relative; z-index: 2; }

                .panel-body h2 {
                    font-family: var(--font-display);
                    font-size: 1.7rem; font-weight: 700; color: #fff;
                    letter-spacing: -.03em; line-height: 1.2; margin-bottom: 10px;
                }

                .panel-desc {
                    font-family: var(--font-body);
                    font-size: .875rem; color: rgba(255,255,255,.5);
                    line-height: 1.65; margin-bottom: 28px;
                }

                /* feature chips */
                .feat-chip {
                    display: flex; align-items: center; gap: 12px;
                    padding: 12px 16px; margin-bottom: 8px;
                    background: rgba(255,255,255,.06);
                    border: 1px solid rgba(255,255,255,.09);
                    border-radius: 12px;
                    font-family: var(--font-body);
                    font-size: .83rem; color: rgba(255,255,255,.75);
                }

                .feat-icon {
                    width: 30px; height: 30px; border-radius: 8px;
                    background: rgba(181,135,63,.2);
                    border: 1px solid rgba(181,135,63,.35);
                    display: flex; align-items: center; justify-content: center;
                    color: #d4a055; font-size: .78rem; flex-shrink: 0;
                }

                /* pasos numerados */
                .step-item {
                    display: flex; align-items: flex-start; gap: 14px;
                    padding: 13px 0;
                    border-bottom: 1px solid rgba(255,255,255,.07);
                }
                .step-item:last-child { border-bottom: none; }

                .step-num {
                    width: 28px; height: 28px; border-radius: 50%;
                    background: rgba(181,135,63,.2);
                    border: 1px solid rgba(181,135,63,.45);
                    display: flex; align-items: center; justify-content: center;
                    font-family: var(--font-mono);
                    font-size: .72rem; font-weight: 700; color: #d4a055;
                    flex-shrink: 0; margin-top: 1px;
                }

                .step-text  { font-family: var(--font-body); font-size: .82rem; color: rgba(255,255,255,.6); line-height: 1.4; }
                .step-title { font-weight: 700; color: rgba(255,255,255,.9); margin-bottom: 2px; font-size: .855rem; }

                .panel-footer {
                    font-family: var(--font-mono);
                    font-size: .7rem; color: rgba(255,255,255,.22);
                    position: relative; z-index: 2;
                }

                /* ── Lado formulario ── */
                .auth-form-side {
                    flex: 1; display: flex; align-items: center; justify-content: center;
                    padding: 56px 40px; background: var(--surface);
                }

                .auth-box { width: 100%; max-width: 420px; }

                /* badge pill dorado */
                .auth-badge {
                    display: inline-flex; align-items: center; gap: 7px;
                    background: var(--g50);
                    border: 1px solid var(--g100);
                    border-radius: 20px; padding: 5px 14px;
                    font-family: var(--font-mono);
                    font-size: .73rem; color: var(--accent); font-weight: 600;
                    margin-bottom: 20px; letter-spacing: .02em;
                }
                .auth-badge .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--g400); flex-shrink: 0; }

                .auth-box-header { margin-bottom: 24px; }

                .auth-box-header h3 {
                    font-family: var(--font-display);
                    font-size: 1.6rem; font-weight: 700; color: var(--text);
                    letter-spacing: -.025em; margin-bottom: 5px;
                }

                .auth-box-header p { font-family: var(--font-body); font-size: .855rem; color: var(--muted); }

                /* campos */
                .field-group { margin-bottom: 16px; }

                .field-label {
                    display: block; font-family: var(--font-body);
                    font-size: .77rem; font-weight: 600;
                    color: var(--text2); margin-bottom: 6px; letter-spacing: .01em;
                }

                .field-wrap { position: relative; }

                .field-input {
                    width: 100%; padding: 11px 14px 11px 40px;
                    border: 1.5px solid var(--border); border-radius: 9px;
                    font-family: var(--font-body); font-size: .875rem;
                    color: var(--text); background: #fff; outline: none;
                    transition: border-color .15s, box-shadow .15s;
                }

                .field-input:focus {
                    border-color: var(--accent);
                    box-shadow: 0 0 0 3px rgba(181,135,63,.12);
                }

                .field-icon {
                    position: absolute; left: 13px; top: 50%;
                    transform: translateY(-50%);
                    color: var(--muted); font-size: .8rem; pointer-events: none;
                }

                .text-danger { font-family: var(--font-body); font-size: .76rem; color: #dc2626; margin-top: 4px; display: block; }

                /* remember */
                .remember-row { display: flex; align-items: center; gap: 8px; margin-bottom: 20px; }
                .remember-row input[type="checkbox"] { width: 15px; height: 15px; accent-color: var(--accent); cursor: pointer; }
                .remember-row label { font-family: var(--font-body); font-size: .82rem; color: var(--muted); cursor: pointer; margin: 0; }

                /* botón dorado */
                .btn-submit {
                    width: 100%; padding: 12px;
                    background: var(--accent); color: #fff;
                    border: none; border-radius: 10px;
                    font-family: var(--font-body); font-size: .9rem; font-weight: 700;
                    cursor: pointer; transition: background .15s, transform .1s;
                    display: flex; align-items: center; justify-content: center; gap: 8px;
                    margin-bottom: 18px; letter-spacing: .01em;
                }
                .btn-submit:hover  { background: var(--g600); }
                .btn-submit:active { transform: scale(.99); }

                /* divider */
                .auth-divider { display: flex; align-items: center; gap: 10px; margin: 0 0 14px; }
                .auth-divider::before, .auth-divider::after { content: ''; flex: 1; height: 1px; background: var(--border); }
                .auth-divider span { font-family: var(--font-body); font-size: .74rem; color: var(--muted); white-space: nowrap; }

                .auth-link-row { text-align: center; font-family: var(--font-body); font-size: .845rem; color: var(--muted); }
                .auth-link-row a { color: var(--g600); font-weight: 600; text-decoration: none; margin-left: 4px; }
                .auth-link-row a:hover { text-decoration: underline; }

                /* barra de seguridad */
                .strength-wrap { margin-top: 8px; }
                .strength-bars { display: flex; gap: 4px; }
                .strength-seg  { flex: 1; height: 3px; border-radius: 2px; background: var(--border); transition: background .3s; }
                .strength-lbl  { font-family: var(--font-mono); font-size: .72rem; color: var(--muted); margin-top: 5px; }

                .field-hint {
                    display: flex; align-items: center; gap: 5px;
                    font-family: var(--font-body);
                    font-size: .73rem; color: var(--muted); margin-top: 6px; line-height: 1.4;
                }
                .field-hint i { color: var(--accent); font-size: .68rem; }

                /* grid 2 columnas para nombre/apellido */
                .field-row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }

                @@media (max-width: 768px) { .auth-panel { display: none; } .field-row-2 { grid-template-columns: 1fr; } }
            </style>
        </head>
        <body>

        @RenderBody()

        <partial name="_Notification" />

        <script>
        function showToast(type, title, message) {
            switch(type) {
                case 'success': toastr.success(message, title); break;
                case 'error':   toastr.error(message, title);   break;
                case 'warning': toastr.warning(message, title); break;
                case 'info':    toastr.info(message, title);    break;
            }
        }
        </script>

        @await RenderSectionAsync("Scripts", required: false)
       </body>
        </html>
