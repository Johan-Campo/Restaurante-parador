<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Estadero Parador Turístico</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DropDownsAnidadosMvc.styles.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=DM+Mono:wght@400;500&family=Fraunces:opsz,wght@9..144,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" />

    <style>
        :root {
            --sidebar-width: 260px;
            --sidebar-mini:  68px;
            --accent:        #3a9e6a;
            --accent-soft:   #f0f9f4;
            --accent-border: #d4eddf;
            --cyan:          #0891b2;
            --cyan-soft:     #ecfeff;
            --cyan-border:   #a5f3fc;
            --g400:  #4db37a;
            --g800:  #1a4f33;
            --text:  #111827;
            --text2: #374151;
            --muted: #6b7280;
            --border:#e5e7eb;
            --surface:#f9fafb;
            --font-display: 'Fraunces', serif;
            --font-body:    'DM Sans', sans-serif;
            --font-mono:    'DM Mono', monospace;
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        html, body { height: 100%; }

        body {
            font-family: var(--font-body);
            background: var(--surface);
            color: var(--text);
            /* NO usar flexbox en body para el layout principal —
               el sidebar es fixed, el main maneja su propio scroll */
        }

        /* ── SIDEBAR ── */
        .sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            position: fixed; top: 0; left: 0;
            background: #fff;
            border-right: 1px solid var(--border);
            display: flex; flex-direction: column;
            transition: width 0.3s ease;
            z-index: 100;
            overflow: hidden;
        }
        .sidebar.collapsed { width: var(--sidebar-mini); }

        .sidebar-top-bar {
            height: 3px;
            background: linear-gradient(90deg, var(--accent), #06b6d4);
            flex-shrink: 0;
        }

        .sidebar-header {
            display: flex; align-items: center; gap: 10px;
            padding: 12px 14px;
            border-bottom: 1px solid var(--border);
            min-height: 66px; flex-shrink: 0;
        }

        .toggle-btn {
            border: none; background: none; color: var(--muted);
            font-size: 16px; cursor: pointer;
            padding: 6px; border-radius: 6px; flex-shrink: 0;
            transition: background .15s, color .15s; line-height: 1;
        }
        .toggle-btn:hover { background: var(--cyan-soft); color: var(--cyan); }

        .sidebar-logo {
            display: flex; align-items: center; gap: 10px;
            overflow: hidden; flex: 1; min-width: 0;
        }

        .logo-icon-box {
            width: 30px; height: 30px; border-radius: 7px;
            background: #fff; border: 1px solid var(--border);
            display: flex; align-items: center; justify-content: center;
            flex-shrink: 0;
        }

        .logo-text-block {
            overflow: hidden; white-space: nowrap;
            transition: opacity .25s, width .3s; opacity: 1;
        }
        .sidebar.collapsed .logo-text-block { opacity: 0; width: 0; }

        .logo-name {
            font-family: var(--font-body);
            font-size: .82rem; font-weight: 700;
            color: var(--text); letter-spacing: -.01em; line-height: 1.2;
        }
        .logo-sub {
            font-family: var(--font-mono);
            font-size: .62rem; color: var(--muted);
            letter-spacing: .04em; margin-top: 1px;
        }

        .sidebar-user {
            display: flex; align-items: center; gap: 9px;
            padding: 10px 14px;
            border-bottom: 1px solid var(--border);
            min-height: 50px; flex-shrink: 0; overflow: hidden;
        }
        .user-avatar {
            width: 28px; height: 28px; border-radius: 50%;
            background: var(--accent-soft);
            border: 1.5px solid var(--accent-border);
            display: flex; align-items: center; justify-content: center;
            font-size: .68rem; color: var(--accent); flex-shrink: 0;
        }
        .user-name {
            font-family: var(--font-body);
            font-size: .78rem; color: var(--text2); font-weight: 500;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
            transition: opacity .25s;
        }
        .sidebar.collapsed .user-name { opacity: 0; }

        .nav-section-label {
            font-family: var(--font-mono);
            font-size: .58rem; letter-spacing: .13em; text-transform: uppercase;
            color: var(--muted); padding: 13px 16px 4px;
            font-weight: 500; white-space: nowrap; overflow: hidden;
            transition: opacity .25s;
        }
        .sidebar.collapsed .nav-section-label { opacity: 0; }

        .nav-links { display: flex; flex-direction: column; padding: 4px 8px 0; }

        .nav-link-custom {
            display: flex; align-items: center; gap: 11px;
            padding: 9px 10px; border-radius: 8px;
            color: var(--muted); text-decoration: none;
            font-family: var(--font-body);
            font-size: .845rem; font-weight: 400;
            transition: background .15s, color .15s;
            position: relative; margin-bottom: 2px;
            white-space: nowrap; overflow: hidden;
            border: 1px solid transparent;
        }
        .nav-link-custom i { width: 18px; text-align: center; font-size: .88rem; flex-shrink: 0; }
        .nav-link-custom span { transition: opacity .25s; }
        .sidebar.collapsed .nav-link-custom span { opacity: 0; }
        .nav-link-custom:hover { background: var(--cyan-soft); color: var(--cyan); text-decoration: none; }
        .nav-link-custom.active {
            background: var(--cyan-soft); color: var(--cyan);
            font-weight: 500; border-color: var(--cyan-border);
        }
        .nav-link-custom.active::before {
            content: '';
            position: absolute; left: 0; top: 20%; bottom: 20%;
            width: 3px; background: var(--cyan);
            border-radius: 0 2px 2px 0;
        }

        /* sidebar footer — siempre pegado al fondo del sidebar */
        .sidebar-footer {
            margin-top: auto;
            padding: 10px 8px;
            border-top: 1px solid var(--border);
            flex-shrink: 0;
        }
        .logout-btn {
            width: 100%; border: 1px solid var(--border);
            background: none;
            display: flex; align-items: center; gap: 11px;
            padding: 9px 10px; border-radius: 8px;
            color: var(--muted);
            font-family: var(--font-body);
            font-size: .845rem;
            cursor: pointer; transition: all .15s;
            white-space: nowrap; overflow: hidden;
        }
        .logout-btn i { flex-shrink: 0; }
        .logout-btn span { transition: opacity .25s; }
        .sidebar.collapsed .logout-btn span { opacity: 0; }
        .logout-btn:hover { background: #fef2f2; border-color: #fecaca; color: #dc2626; }

        /* ── MAIN WRAPPER ──
           margin-left = ancho del sidebar (fixed).
           min-height: 100vh para que el footer baje al fondo
           cuando el contenido es corto.
           display:flex + flex-direction:column permite que
           el footer se pegue al fondo con margin-top:auto.       */
        .main-wrapper {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            transition: margin-left .3s ease;
        }
        .main-wrapper.expanded { margin-left: var(--sidebar-mini); }

        /* el <main> crece y empuja el footer hacia abajo */
        .main-wrapper > main {
            flex: 1;
            padding: 32px 36px;
        }

        /* ── FOOTER ── */
        footer.site-footer {
            background: #fff;
            border-top: 1px solid var(--border);
            /* flex-shrink:0 evita que se comprima cuando hay poco contenido */
            flex-shrink: 0;
        }
        .footer-inner {
            display: flex; align-items: center; justify-content: space-between;
            padding: 13px 36px; flex-wrap: wrap; gap: 8px;
        }
        .footer-brand {
            display: flex; align-items: center; gap: 8px;
            font-family: var(--font-body);
            font-size: .82rem; font-weight: 600; color: var(--text);
        }
        .footer-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--cyan); }
        .footer-copy {
            font-family: var(--font-body);
            font-size: .77rem; color: var(--muted);
        }
    </style>
</head>
<body>

@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
}

<!-- SIDEBAR -->
<div id="sidebar" class="sidebar collapsed">
    <div class="sidebar-top-bar"></div>

    <div class="sidebar-header">
        <button onclick="toggleSidebar()" class="toggle-btn">
            <i class="fas fa-bars"></i>
        </button>
        <div class="sidebar-logo">
            <div class="logo-icon-box">
                <svg viewBox="0 0 1024 1024" style="width:26px;height:26px" xmlns="http://www.w3.org/2000/svg">
                    <path d="M757.733053 485.052632H565.894737a80.842105 80.842105 0 0 0-80.842105 80.842105v215.578947c0 40.96 43.546947 99.678316 77.446736 139.210105C596.426105 960.215579 603.055158 970.105263 603.055158 970.105263H754.526316s15.144421-18.674526 45.891368-58.071579S862.315789 809.984 862.315789 717.608421c0-89.573053-47.993263-166.346105-104.582736-232.555789z" fill="#40983e"/>
                    <path d="M538.947368 1024h-53.894736c0-32.794947 25.869474-87.417263 77.446736-103.316211C528.599579 881.152 485.052632 822.433684 485.052632 781.473684c0-44.570947 36.271158-80.842105 80.842105-80.842105h80.842105v53.894737h-80.842105a26.947368 26.947368 0 0 0-26.947369 26.947368c0 19.725474 36.675368 77.473684 92.133053 134.736842h88.602947c20.210526-14.147368 88.737684-71.464421 88.737685-198.602105 0-108.382316-93.237895-202.967579-168.151579-278.986105-49.502316-50.202947-88.576-89.842526-98.735158-128.61979-11.749053-44.732632-21.584842-112.586105-26.327579-148.318315H377.263158c-45.136842 0-89.519158 8.434526-121.802105 53.894736H431.157895v53.894737c-97.28 0-107.789474 113.071158-107.789474 161.684211v53.894737h53.894737v161.68421h-53.894737v-107.789474h-26.947368c-170.253474 0-188.631579-94.234947-188.631579-134.736842 0-31.043368 35.220211-72.326737 55.727158-93.722947 2.694737-14.686316 5.847579-28.348632 9.431579-41.013895H161.684211V215.578947h31.528421C239.642947 120.993684 317.224421 107.789474 377.263158 107.789474h185.640421l2.802526 23.794526c0.134737 1.050947 12.719158 106.657684 27.944421 164.756211 6.494316 24.872421 44.624842 63.514947 84.965053 104.448C760.481684 483.813053 862.315789 587.129263 862.315789 717.608421c0 92.375579-31.124211 155.028211-61.898105 194.425263C904.919579 892.146526 970.105263 803.004632 970.105263 673.684211c0-91.405474-42.819368-154.381474-84.237474-215.255579C847.791158 402.458947 808.421053 344.576 808.421053 269.473684c0-119.349895 87.093895-161.684211 161.68421-161.68421v53.894737c-32.417684 0-107.789474 10.509474-107.789474 107.789473 0 58.502737 31.555368 104.933053 68.096 158.639158C974.282105 492.597895 1024 565.679158 1024 673.684211c0 177.286737-108.301474 296.421053-269.473684 296.421052h-161.684211c-37.672421 0-53.894737 40.906105-53.894737 53.894737zM323.368421 1024h-53.894737c0-32.794947 25.869474-87.417263 77.446737-103.316211C313.020632 881.152 269.473684 822.433684 269.473684 781.473684c0-44.570947 36.271158-80.842105 80.842105-80.842105h45.16379A188.847158 188.847158 0 0 1 565.894737 592.842105h134.736842v53.894737h-134.736842c-74.293895 0-134.736842 60.442947-134.736842 134.736842v26.516211l-53.894737 0.377263V781.473684c0-9.162105 0.646737-18.135579 1.913263-26.947368H350.315789c-14.848 0-26.947368 12.072421-26.947368 26.947368 0 19.725474 36.675368 77.473684 92.133053 134.736842H431.157895v53.894737h-53.894737c-37.672421 0-53.894737 40.906105-53.894737 53.894737z" fill="#231F20"/>
                </svg>
            </div>
            <div class="logo-text-block">
                <div class="logo-name">Estadero Parador</div>
                <div class="logo-sub">Gestión de sucursales</div>
            </div>
        </div>
    </div>

    <div class="sidebar-user">
        <div class="user-avatar"><i class="fas fa-user" style="font-size:.65rem;"></i></div>
        <span class="user-name">@User.Identity?.Name</span>
    </div>

    <div class="nav-section-label">General</div>
    <div class="nav-links">
        <a asp-controller="Home" asp-action="Index"
           class="nav-link-custom @(controller == "Home" ? "active" : "")">
            <i class="fas fa-home"></i><span>Inicio</span>
        </a>
    </div>

    <div class="nav-section-label">Gestión</div>
    <div class="nav-links">
        <a asp-controller="Sucursales" asp-action="Index"
           class="nav-link-custom @(controller == "Sucursales" ? "active" : "")">
            <i class="fas fa-store"></i><span>Sucursales</span>
        </a>
        <a asp-controller="Categorias" asp-action="Index"
           class="nav-link-custom @(controller == "Categorias" ? "active" : "")">
            <i class="fas fa-tags"></i><span>Categorías</span>
        </a>
        <a asp-controller="Productos" asp-action="Index"
           class="nav-link-custom @(controller == "Productos" ? "active" : "")">
            <i class="fas fa-box-open"></i><span>Productos</span>
        </a>
        <a asp-controller="Pedidos" asp-action="Index"
           class="nav-link-custom @(controller == "Pedidos" ? "active" : "")">
            <i class="fas fa-receipt"></i><span>Pedidos</span>
        </a>
    </div>

    <div class="nav-section-label">Cuenta</div>
    <div class="nav-links">
        <a asp-area="Identity" asp-page="/Account/Manage/Index"
           class="nav-link-custom">
            <i class="fas fa-user-cog"></i><span>Mi perfil</span>
        </a>
    </div>

    <div class="sidebar-footer">
        <form method="post" asp-area="Identity" asp-page="/Account/Logout"
              asp-route-returnUrl="@Url.Page("/Account/Login", new { area = "Identity" })">
            <button type="submit" class="logout-btn">
                <i class="fas fa-sign-out-alt"></i><span>Cerrar sesión</span>
            </button>
        </form>
    </div>
</div>

<!-- MAIN -->
<div id="mainWrapper" class="main-wrapper expanded">
    <main role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="footer-inner">
            <div class="footer-brand">
                <div class="footer-dot"></div>
                Estadero Parador Turístico
            </div>
            <span class="footer-copy">© 2026 — Todos los derechos reservados</span>
        </div>
    </footer>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script>
    function toggleSidebar() {
        document.getElementById("sidebar").classList.toggle("collapsed");
        document.getElementById("mainWrapper").classList.toggle("expanded");
    }
</script>

<partial name="_Notification" />

@await RenderSectionAsync("Scripts", required: false)

<script>
    if (typeof $.validator !== 'undefined') {
        $.validator.methods.number = function (value, element) {
            return this.optional(element) || /^-?\d+(,\d+)?$/.test(value);
        };
        $.validator.methods.range = function (value, element, param) {
            if (this.optional(element)) return true;
            value = value.replace(",", ".");
            return parseFloat(value) >= param[0] && parseFloat(value) <= param[1];
        };
    }
</script>

</body>
</html>
