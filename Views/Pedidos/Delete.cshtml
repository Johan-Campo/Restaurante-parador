@model DropDownsAnidadosMvc.Models.Pedido
@{ ViewData["Title"] = "Eliminar pedido"; }

<style>
    :root{--g50:#f5e8d0;--g100:#e8d0a0;--g400:#b5873f;--g600:#8a6230;--g800:#1a2820;--accent:#b5873f;--text:#1c1a17;--muted:#8b8680;--border:#e0d8cc;--surface:#faf7f2;}
    .eyebrow{font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;color:#8b1a2a;font-weight:600;margin-bottom:4px;}
    .page-header{margin-bottom:24px;} .page-header h1{font-size:1.7rem;color:var(--text);font-weight:700;margin-bottom:4px;} .page-header .sub{color:var(--muted);font-size:.875rem;margin-bottom:12px;} .divider-red{width:36px;height:3px;background:#8b1a2a;border-radius:2px;margin-bottom:22px;}
    .panel{background:#fff;border-radius:14px;border:1px solid var(--border);overflow:hidden;max-width:480px;}
    .panel-head{padding:14px 20px;background:#5c1020;display:flex;align-items:center;gap:10px;}
    .panel-head-icon{width:32px;height:32px;border-radius:8px;background:rgba(255,255,255,.12);display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,.85);font-size:.9rem;}
    .panel-head h5{font-size:.9rem;color:#fff;margin:0;font-weight:600;} .panel-head p{font-size:.7rem;color:rgba(255,255,255,.5);margin:1px 0 0;}
    .panel-body{padding:20px;}
    .warn-box{background:#fdf0f2;border:1px solid #f0b8c0;border-radius:8px;padding:12px 14px;font-size:.855rem;color:#6b1020;margin-bottom:16px;}
    .detail-row{display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--border);font-size:.875rem;}
    .detail-row:last-of-type{border-bottom:none;}
    .detail-label{color:var(--muted);font-size:.75rem;font-weight:600;text-transform:uppercase;}
    .btn-delete{display:flex;align-items:center;justify-content:center;gap:7px;width:100%;padding:9px;background:#8b1a2a;color:#fff;border:none;border-radius:8px;font-size:.875rem;font-weight:600;cursor:pointer;transition:background .15s;margin-top:16px;} .btn-delete:hover{background:#6b1020;}
    .btn-back{display:inline-flex;align-items:center;justify-content:center;gap:6px;width:100%;padding:8px;background:#fff;color:var(--muted);border:1px solid var(--border);border-radius:8px;font-size:.855rem;text-decoration:none;transition:all .15s;margin-top:8px;} .btn-back:hover{border-color:var(--g200);color:var(--text);text-decoration:none;}
</style>

<div class="page-header">
    <div class="eyebrow">Eliminar</div>
    <h1>Pedido #@Model.Id</h1>
    <p class="sub">Esta acción no se puede deshacer</p>
    <div class="divider-red"></div>
</div>

<div class="panel">
    <div class="panel-head">
        <div class="panel-head-icon"><i class="fas fa-exclamation-triangle"></i></div>
        <div><h5>Confirmar eliminación</h5><p>Pedido #@Model.Id · @Model.Items.Count ítem(s)</p></div>
    </div>
    <div class="panel-body">
        <div class="warn-box">
            <i class="fas fa-exclamation-circle" style="margin-right:6px;"></i>
            Se eliminará el pedido y todos sus ítems de forma permanente.
        </div>

        <div class="detail-row">
            <span class="detail-label">Cliente</span>
            <span>@(string.IsNullOrEmpty(Model.NombreCliente) ? "Sin nombre" : Model.NombreCliente)</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Mesa</span>
            <span>@(string.IsNullOrEmpty(Model.NumeroMesa) ? "—" : Model.NumeroMesa)</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Estado</span>
            <span>@Model.Estado</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Total</span>
            <span style="font-weight:700;color:var(--g600);">$@Model.Total.ToString("0.00")</span>
        </div>

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn-delete">
                <i class="fas fa-trash"></i> Sí, eliminar pedido
            </button>
        </form>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn-back">
            <i class="fas fa-arrow-left"></i> Cancelar
        </a>
    </div>
</div>
